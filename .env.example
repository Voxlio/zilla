# Environment variables for Zilla
#
# Copy this file to `.env.local` and paste your real keys there.
# `.env.local` is gitignored; THIS file is not, so never put real values in it.
#
#   cp .env.example .env.local
#
# All four providers have free tiers. The app degrades gracefully if a key is
# missing: /api/candles tries Twelve Data then Alpha Vantage, /api/news tries
# Finnhub then NewsAPI, and /api/calendar uses a keyless public feed first.

# Price candles. Primary source. Free tier: 8 requests/min, 800/day.
# https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=

# Price candles. Fallback when Twelve Data fails or is rate-limited.
# Free tier: 5 requests/min, 25/day.
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# News headlines (primary) and economic calendar (fallback).
# https://finnhub.io/dashboard
FINNHUB_API_KEY=

# News headlines. Fallback when Finnhub fails.
# https://newsapi.org/account
NEWS_API_KEY=

# Public base URL of this app. Used for absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
